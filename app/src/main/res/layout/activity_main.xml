<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hudText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold" />

        <Button
            android:id="@+id/profileButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NORMAL" />

        <Switch
            android:id="@+id/highContrastSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High contrast" />
    </LinearLayout>

    <TextView
        android:id="@+id/messageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/rewardRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/rewardAButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:text="Reward A" />

        <Button
            android:id="@+id/rewardBButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:text="Reward B" />

        <Button
            android:id="@+id/rewardCButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:text="Reward C" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/endRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/summaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/retryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/retry_seed" />

            <Button
                android:id="@+id/nextSeedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/next_seed" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/branchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/branchAButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:text="Path A" />

        <Button
            android:id="@+id/branchBButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:text="Path B" />
    </LinearLayout>

    <com.sdvgdeploy.glyphbound.GlyphMapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/legendText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:text="@:you S:start E:exit #:wall .:floor ~:risk o:oil w:water *:spark f:fire ^:fire-zone !:shock-zone &amp;:mixed"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/draughtButton"
                android:layout_width="84dp"
                android:layout_height="56dp"
                android:minHeight="56dp"
                android:enabled="false"
                android:text="@string/draught_none"
                android:textSize="12sp" />

            <Button
                android:id="@+id/upButton"
                android:layout_width="84dp"
                android:layout_height="56dp"
                android:minHeight="56dp"
                android:text="↑"
                android:textSize="22sp" />

            <Space
                android:layout_width="84dp"
                android:layout_height="56dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/leftButton"
                android:layout_width="84dp"
                android:layout_height="56dp"
                android:minHeight="56dp"
                android:text="←"
                android:textSize="22sp" />

            <Button
                android:id="@+id/downButton"
                android:layout_width="84dp"
                android:layout_height="56dp"
                android:minHeight="56dp"
                android:text="↓"
                android:textSize="22sp" />

            <Button
                android:id="@+id/rightButton"
                android:layout_width="84dp"
                android:layout_height="56dp"
                android:minHeight="56dp"
                android:text="→"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
